# Copy to `.env` (git-ignored) or export these in your host's environment.

# HTTP port the iOS app registers with (Settings › Push relay URL).
PORT=8787

# APNs auth key from the Apple Developer portal (Keys › + › Apple Push Notifications service).
# All three are required for pushes; without them the server only stores registrations.
APNS_KEY_PATH=./AuthKey_ABC123DEFG.p8
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=TEAMID1234

# Bundle id of the APP target (PRODUCT_BUNDLE_IDENTIFIER in project.yml), not the widget extension.
# The APNs topic becomes <bundle id>.push-type.liveactivity.
APNS_BUNDLE_ID=com.sleeperwidget.app

# How often to poll Sleeper and push updates while games are on.
POLL_INTERVAL_SECONDS=60

# Where registrations are persisted (JSON file, written atomically).
STORE_PATH=./registrations.json

# Optional. When set, PUT/DELETE /v1/registrations/* require `Authorization: Bearer <token>`.
# The iOS RelayClient does not send this header today, so only enable it on a private
# deployment after adding the header to Shared/RelayClient.swift.
#RELAY_AUTH_TOKEN=change-me
